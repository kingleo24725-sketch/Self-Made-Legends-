{
  "name": "legends-only",
  "version": "0.1.0",
  "description": "Your own crew of AI agents studies the real world every night and hands you a personal, legal, full-day money plan every morning. Everyone with the app competes on one world leaderboard.",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --runInBand",
    "native:setup": "npm install --no-save @capacitor/core @capacitor/cli @capacitor/ios @capacitor/android",
    "native:add:ios": "npx cap add ios",
    "native:add:android": "npx cap add android",
    "native:sync": "npx cap sync"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "stripe": "^18.5.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node"
  }
}
