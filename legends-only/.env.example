# Copy to .env. Never commit .env.
PORT=3000

# Turns the agent crew on. Without it the app still works using the built-in playbook.
ANTHROPIC_API_KEY=

# Optional: override the model the crew uses (default claude-opus-5).
# CREW_MODEL=claude-opus-5

# Optional: where the SQLite file lives (default ./data/legends-only.db). On Railway
# point this at a mounted volume so plans survive deploys.
# DB_PATH=/data/legends-only.db

# ── Growth round ────────────────────────────────────────────────────────────
# Phone verification texts (Twilio). Without these the code is printed to the server log (dev only).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15551234567

# Ops alarms: JSON POST to a Slack/Discord/SMS webhook, and/or the owner's user id for in-app alerts.
# ALERT_WEBHOOK_URL=
# OWNER_USER_ID=

# Where clips and other files live (default ./data). Mount a volume in production.
# DATA_DIR=/data

# Fan Club subscription (Stripe price id). ALLOW_FREE_CLUB=1 lets fans join without billing while testing.
# STRIPE_PRICE_FANCLUB=
# ALLOW_FREE_CLUB=0
# Share of each month's vote revenue that funds the People's Champion check (percent).
# FAN_PRIZE_PCT=20
