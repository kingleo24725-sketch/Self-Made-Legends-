# Self-Made Legends — environment
#
# Copy to .env and fill in. `.env` is gitignored and must stay that way —
# it is the one file in this repo that must never be committed.
#
#   cp .env.example .env
#
# Nothing here has a working default on purpose. A placeholder that looks
# plausible (https://manufacturer.example.com) is worse than an empty value:
# the code accepts it, the request goes nowhere, and the failure looks like
# a bug in your integration instead of a missing setting.


# ─────────────────────────────────────────────────────────────────────────
#  THE TRADING GAME  —  src/api-server.js
# ─────────────────────────────────────────────────────────────────────────

PORT=3000

# Set to false ONLY to switch the market analysis engine off.
# Unset or true keeps the AI coach producing signals.
TRADING_ENABLED=true

INITIAL_CAPITAL=1
STOCKS=AAPL,MSFT,GOOGL
MAX_POSITION_SIZE=0.2
MAX_LOSS_PERCENT=2
MIN_GAIN_PERCENT=1.5

# Where sml.db lives. On Railway this MUST point at a mounted volume or
# every deploy wipes every player account. See OPERATIONS.md §4.
DATA_DIR=

# Protects the admin dashboard and the marketing engine endpoints.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET_KEY=

STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_CREATOR_PRICE_ID=

# The secret key is the one that matters. It must never appear in anything
# served to a browser, in this repo, or in a message to anyone — including me.


# ─────────────────────────────────────────────────────────────────────────
#  THE AGENTS  —  agents/
# ─────────────────────────────────────────────────────────────────────────

# Leave unset to call the real API. Set to 1 to run everything on stubs:
# free, no key needed, no partner contact. The CLI and the eval harness
# default to stub mode on their own.
SML_AGENTS_STUB=

ANTHROPIC_API_KEY=

# Where the event log and example store are written. On Railway, a mounted
# volume — these are the record the agents learn from.
SML_EVENT_DIR=
SML_EXAMPLE_DIR=


# ─────────────────────────────────────────────────────────────────────────
#  THE COMMERCE API  —  agents/api/server.js
# ─────────────────────────────────────────────────────────────────────────

# REQUIRED. The server refuses to start without it, because without it
# anyone on the internet can upload files to your server.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SML_API_KEY=

# Its own port. NOT 3000 — that is the trading game, and two processes on
# one port means whichever started second dies.
PORT_COMMERCE=3100

# Database and uploads. On Railway, a mounted volume, or every deploy
# wipes the uploaded tech packs.
SML_API_DATA_DIR=


# ─────────────────────────────────────────────────────────────────────────
#  PARTNERS
# ─────────────────────────────────────────────────────────────────────────

# ⚠️  LEFTY DISTRIBUTION — UNVERIFIED
#
# No public API documentation could be found (27 Aug 2026). The adapter in
# agents/partners/lefty.js is a placeholder built on how these integrations
# normally work, and the field names in it are guesses.
#
# LEAVE THESE EMPTY until you have their real documentation. Empty keeps
# the adapter in mock mode, where it cannot send anything anywhere. Filling
# them in points unverified code at a live partner.
LEFTY_API_BASE=
LEFTY_API_KEY=

# The manufacturer runs on agents/partners/sandbox.js — a fake factory that
# refuses work it cannot do and holds tech packs with unanswered questions.
# When you have a real one, add agents/partners/<name>.js alongside it and
# register it in agents/partners/index.js. There is no MANUFACTURER_API_URL
# because a raw URL cannot express what a partner can and cannot make, and
# that is exactly what the routing agent needs to know.
#
# Set to 1 to make the sandbox unreachable, for testing what happens when a
# partner goes down.
SML_SANDBOX_DOWN=


# ─────────────────────────────────────────────────────────────────────────
#  MAIL  —  used by the game's notifications
# ─────────────────────────────────────────────────────────────────────────

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@selfmadelegendsz.com
