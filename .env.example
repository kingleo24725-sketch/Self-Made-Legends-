# REAL MONEY APIs - Get your keys and add them here!

# Stock Trading - Alpaca
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_API_SECRET=your_alpaca_api_secret
# Use https://paper-api.alpaca.markets for paper trading
# Use https://api.alpaca.markets for REAL MONEY TRADING
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Crypto Trading - Binance or Kraken
CRYPTO_EXCHANGE=binance
CRYPTO_API_KEY=your_binance_api_key
CRYPTO_API_SECRET=your_binance_api_secret

# Card Payments - Stripe
STRIPE_API_KEY=your_stripe_api_key
STRIPE_SECRET_KEY=your_stripe_secret_key

# Bank Connections - Plaid
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret

# Stock Data
ALPHA_VANTAGE_API_KEY=your_api_key_here
POLYGON_API_KEY=your_api_key_here

# Trading Configuration
# Start with ANY amount - $1, $10, $100, $1000, etc. No limits!
INITIAL_CAPITAL=1
MAX_POSITION_SIZE=0.2
MAX_LOSS_PERCENT=2
MIN_GAIN_PERCENT=1.5
TRADING_ENABLED=false

# Database
DB_PATH=./data/trading_bot.db

# Server
PORT=3000
NODE_ENV=development

# Stock List
STOCKS=AAPL,MSFT,GOOGL,AMZN,TSLA,META,NFLX,NVDA,AMD,PYPL
