# Beauty Bond™ — a Self-Made Legends LLC (SML) product.
# Copyright © 2026 Self-Made Legends LLC (SML). All rights reserved.
#
# Copy to .env and fill in. NEVER commit .env.
# No production secret ever ships in the mobile bundle — the client holds
# only the publishable Stripe key and the API URL.

# ── Core ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/beauty_bond
REDIS_URL=redis://localhost:6379

# ── Auth ────────────────────────────────────────────────────────────
JWT_SECRET=
REFRESH_SECRET=

# ── Stripe ──────────────────────────────────────────────────────────
# Beauty Bond's OWN Stripe account — separate from every other SML product.
#
# Use a RESTRICTED key, not sk_live_. Scope it to Products/Prices write,
# Customers/Subscriptions write, and Billing Portal. No Connect, no Payouts,
# no account settings. Seed the catalogue in test mode first.
STRIPE_SECRET_KEY_BB=
STRIPE_WEBHOOK_SECRET_BB=
STRIPE_PORTAL_CONFIG_ID_BB=
STRIPE_PUBLISHABLE_KEY=

# ── App stores (required for mobile — IAP is mandatory for digital goods) ──
APPLE_SHARED_SECRET=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# ── LiveKit (Glam Rooms) ────────────────────────────────────────────
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=
LIVEKIT_WEBHOOK_KEY=

# ── Storage ─────────────────────────────────────────────────────────
S3_BUCKET_MEDIA=
S3_BUCKET_EPHEMERAL=
CLOUDFRONT_KEY_PAIR_ID=
KMS_KEY_ID=

# ── ML service (try-on) ─────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:9000

# ── Comms ───────────────────────────────────────────────────────────
POSTMARK_TOKEN=
TWILIO_SID=
TWILIO_TOKEN=
EXPO_ACCESS_TOKEN=

# ── Content ─────────────────────────────────────────────────────────
SANITY_PROJECT_ID=
SANITY_TOKEN=

# ── Observability ───────────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
