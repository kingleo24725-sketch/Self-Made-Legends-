# All Shades of Brown — environment
PORT=4000
BASE_URL=http://localhost:4000

# Stripe (leave blank to run in demo mode with no real payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Password for the admin dashboard at /admin.html (must be changed from this value)
ADMIN_TOKEN=change-me

# Email alerts for new bookings and form submissions (optional)
NOTIFY_EMAIL=fyi@myasbllc.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
